# Copy these names into your deployment environment. Do not put real values in
# this example file and do not commit a populated .env file.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-smtp-user@example.com
EMAIL_HOST_PASSWORD=replace-with-a-new-app-password
DEFAULT_FROM_EMAIL=your-smtp-user@example.com
